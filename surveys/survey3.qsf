on":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID50"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID51","SecondaryAttribute":"Do you watch YouTube while logged in into your Google Account?","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you watch YouTube while logged in into your Google Account?","DefaultChoices":false,"DataExportTag":"C4","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you watch YouTube while logged in into your Google Account?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"},"3":{"Display":"I'm not sure"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID51"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID52","SecondaryAttribute":"Would you be willing to delete your YouTube history as part of a research experiment? This means...","TertiaryAttribute":null,"Payload":{"QuestionText":"Would you be willing to delete your YouTube history as part of a research experiment?<br><br>This means that previous videos you have watched would no longer be available on your YouTube history and that you would loose the personalization that YouTube does for your individual profile.<br><br>","DefaultChoices":false,"DataExportTag":"C5","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":true}}},"QuestionDescription":"Would you be willing to delete your YouTube history as part of a research experiment? This means...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID52"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"\u201cWhich of the following best describes a vegan diet?\u201d Options: A. A diet that excludes red meat ","TertiaryAttribute":null,"Payload":{"QuestionText":"\u201cWhich of the following best describes a vegan diet?\u201d\n\nOptions:\n\nA. A diet that excludes red meat but includes poultry, fish, and dairy\nB. A diet that excludes all meat but includes eggs and dairy\nC. A diet that excludes all animal products, including meat, dairy, eggs, and honey\nD. A diet that includes only raw fruits and vegetables","DefaultChoices":false,"DataExportTag":"KNOWLEDGE","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u201cWhich of the following best describes a vegan diet?\u201d Options: A. A diet that excludes red meat b...","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID53"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID54","SecondaryAttribute":"Your YouTube history contains the videos you have watched and the searches you have made on the p...","TertiaryAttribute":null,"Payload":{"QuestionText":"Your YouTube history contains the videos you have watched and the searches you have made on the platform, see below.<br \/>\n<br \/>\n<br \/>\n<img alt=\"Access Watch History on YouTube website\" src=\"https:\/\/media.idownloadblog.com\/wp-content\/uploads\/2024\/01\/Access-Watch-History-on-YouTube-website.jpg\" style=\"width: 100%\" \/>","DefaultChoices":false,"DataExportTag":"TEXT_02","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Your YouTube history contains the videos you have watched and the searches you have made on the p...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID54"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID55","SecondaryAttribute":"In this study, we ask you to donate your YouTube history for research purposes. We ask you to fol...","TertiaryAttribute":null,"Payload":{"QuestionText":"In this study, we ask you to donate your YouTube history for research purposes. <br><br>We ask you to follow the instructions below to make a request for Google to provide you with your data now. <br><br>In a day or two, we will contact you with the next steps.<br><br>1. Go to&nbsp;https:\/\/takeout.google.com\/settings\/takeout<br>","DefaultChoices":false,"DataExportTag":"Q55","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In this study, we ask you to donate your YouTube history for research purposes. We ask you to fol...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID55"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"Would you be willing to donate your YouTube history as part of a research experiment? This means...","TertiaryAttribute":null,"Payload":{"QuestionText":"Would you be willing to donate your YouTube history as part of a research experiment? <br><br>This means you would extract all videos you have watched in the past and send them for research purposes. The exact details on how your data will be used will be discussed later on, but here we want to know if you are open to this possibility.","DefaultChoices":false,"DataExportTag":"C6","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":true}}},"QuestionDescription":"Would you be willing to donate your YouTube history as part of a research experiment? This means...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID56"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID57","SecondaryAttribute":"This survey is the first step in a three-part study.\u00a0 Part #1 (this survey; ~10 minutes): You wil..","TertiaryAttribute":null,"Payload":{"QuestionText":"This survey is the first step in a three-part study.&nbsp;<br>\n<br>\n<strong>Part #1 <\/strong>(this survey; ~10 minutes):\n<ol>\n\t<li>You will answer a questionnaire.<\/li>\n\t<li>You will&nbsp;<\/li>\n<\/ol>\n<br>\n<strong>Part #2 <\/strong>(in two to three days; ~30 minutes):\n\n<ol>\n\t<li>You will donate&nbsp;your YouTube history for research.<\/li>\n\t<li>You will watch a couple of YouTube videos.<\/li>\n\t<li>You will answer a questionnaire.<\/li>\n\t<li>You will be asked to delete your YouTube history.<\/li>\n<\/ol>\n<br>\n<strong>Part #3&nbsp;<\/strong>(in a month; ~10 minutes)\n\n<ol>\n\t<li>You will again be asked to donate your YouTube history.<\/li>\n\t<li>You will answer a questionnaire.<\/li>\n<\/ol><div><br><\/div><div>Upon completing the experiment, we will reward you with an additional $40. Would you be willing to participate?&nbsp;<\/div><div><\/div>&nbsp;","DefaultChoices":false,"DataExportTag":"Q57","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This survey is the first step in a three-part study.\u00a0 Part #1 (this survey; ~10 minutes): You wil...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID57"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"This survey is the first step in a three-part study.\u00a0 Part #1 (this survey; ~10 minutes): You wil..","TertiaryAttribute":null,"Payload":{"QuestionText":"This survey is the first step in a three-part study.&nbsp;<br>\n<br>\n<strong>Part #1 <\/strong>(this survey; ~10 minutes):\n<ol>\n\t<li>You will answer a questionnaire.<\/li>\n\t<li>You will request your YouTube history to Google.<\/li>\n<\/ol>\n<br>\n<strong>Part #2 <\/strong>(in two to three days; ~30 minutes):\n\n<ol>\n\t<li>You will donate&nbsp;your YouTube history for research.<\/li>\n\t<li>You will watch a couple of YouTube videos.<\/li>\n\t<li>You will answer a questionnaire.<\/li>\n\t<li>You will be asked to delete your YouTube history.<\/li>\n<\/ol>\n<br>\n<strong>Part #3&nbsp;<\/strong>(in a month; ~10 minutes)\n\n<ol>\n\t<li>You will again be asked to donate your YouTube history.<\/li>\n\t<li>You will answer a questionnaire.<\/li>\n<\/ol><div><br><\/div><div>Upon completing the experiment, we will reward you with an additional $40. Would you be willing to participate?&nbsp;<\/div><div><\/div>&nbsp;","DefaultChoices":false,"DataExportTag":"C7","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":true}}},"QuestionDescription":"This survey is the first step in a three-part study.\u00a0 Part #1 (this survey; ~10 minutes): You wil...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID58"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"I avoid interacting with vegans whenever possible.","TertiaryAttribute":null,"Payload":{"QuestionText":"I avoid interacting with vegans whenever possible.","DataExportTag":"ATVS03","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"I avoid interacting with vegans whenever possible.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID6"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Please read each of the following statements about vegans and veganism and indicate the extent to...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please read each of the following statements about vegans and veganism and indicate the extent to which you agree or disagree.","DefaultChoices":false,"DataExportTag":"ATVS_1","QuestionID":"QID7","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","Autoscale":{"XScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please read each of the following statements about vegans and veganism and indicate the extent to...","Choices":{"1":{"Display":"Vegans preach too much about their beliefs and eating habits."},"2":{"Display":"Vegans should not try to hide their eating habits."},"3":{"Display":"Vegan eating habits are harmful to the traditions of this country."},"4":{"Display":"This is just an attention check. Please mark somewhat disagree."},"5":{"Display":"You can eat a balanced diet without animal products."},"6":{"Display":"Vegans are overly concerned about gaining weight."},"7":{"Display":"Vegans are psychologically unhealthy."},"8":{"Display":"Individuals who don\u2019t consume animal products are \u201cwimpier\u201d than individuals who do"}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":8,"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"Somewhat agree"},"6":{"Display":"Agree"},"7":{"Display":"Strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Vegan eating habits are harmful to the traditions of this country.","TertiaryAttribute":null,"Payload":{"QuestionText":"Vegan eating habits are harmful to the traditions of this country.","DataExportTag":"ATVS03","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"Vegan eating habits are harmful to the traditions of this country.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID8"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID84","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q84","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID84"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID85","SecondaryAttribute":"We ask you to donate your YouTube history for research purposes. We ask you to follow the instruc...","TertiaryAttribute":null,"Payload":{"QuestionText":"We ask you to donate your YouTube history for research purposes.<br>\n<br>\nWe ask you to follow the instructions below to make a request for Google to provide you with your data.<br>\n<br>\nWe will contact you with the next steps in a day. By then, Google should have sent you the data.<br><br><b>Please request your YouTube history for the same Google account that you have been using for the previous components in this study.<\/b><br>\n<br>\n1. Go to Google Takeout (this will open in a new tab:&nbsp;<a target=\"_blank\" href=\"https:\/\/takeout.google.com\/settings\/takeout\" rel=\"noopener\">https:\/\/takeout.google.com\/settings\/takeout<\/a>).<br>\n2. Click on \u201cDeselect All.\u201d<br>\n3. Scroll all the way down until you reach an item called \u201cYouTube and YouTube Music\u201d. Select this item.<br>\n4. Click on \u201cMultiple formats,\u201d and change the search history format to \u201cjson.\u201d<br>5. Click on \"All YouTube data included,\" so that a pop-up will open. (Note: if this button does not appear, try refreshing the page or waiting a few minutes and trying again. If that still fails, you can skip step 6 directly below, request the full takeout and upload only the history file in the next survey.)<br>6. Click on \"Deselect all\" and then select only \"history.\" <b>This is important!<br><\/b>7. Select \u201cNext steps.\u201d&nbsp;<br>8. Change \u201cFile size\u201d to 50 GB.<br>9. Click \u201cCreate export.\u201d<br>\n<br>\nThis video reproduces the instructions above:<br>\n<br>\n<iframe title=\"YouTube video player\" style=\"width:100%; height:800px;\" src=\"https:\/\/www.youtube.com\/embed\/0JP_uwa8FAE\"><\/iframe><br>\n<br>\nHave you requested your data for takeout? (This takeout must be for the same YouTube account you previously uploaded a takeout for and have continued to watch YouTube with over the past couple weeks. The $10 bonus payment is conditional upon your using the same YouTube account throughout the study.)","DefaultChoices":false,"DataExportTag":"EXTRACTION","QuestionID":"QID85","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":true}}},"QuestionDescription":"We ask you to donate your YouTube history for research purposes. We ask you to follow the instruc...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID86","SecondaryAttribute":"Thank you for taking this survey. We will contact you to participate in the final step in 1-2 day...","TertiaryAttribute":null,"Payload":{"QuestionText":"Thank you for taking this survey. We will contact you to participate in the final step in 1-2 days, once Google has provided you with your data. Please continue to be redirected to Prolific.","DefaultChoices":false,"DataExportTag":"END_TEXT","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for taking this survey. We will contact you to participate in the final step in 1-2 day...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID86"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"You can eat a balanced diet without animal products.","TertiaryAttribute":null,"Payload":{"QuestionText":"You can eat a balanced diet without animal products.","DataExportTag":"ATVS05","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"You can eat a balanced diet without animal products.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID9"}},{"SurveyID":"SV_9nKsOLWKYlQwPBQ","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}