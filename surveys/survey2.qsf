ologically unhealthy.","TertiaryAttribute":null,"Payload":{"QuestionText":"Vegans are psychologically unhealthy.","DataExportTag":"ATVS02","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"Vegans are psychologically unhealthy.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID5"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID50","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"C","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID50"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID51","SecondaryAttribute":"Do you watch YouTube while logged in into your Google Account?","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you watch YouTube while logged in into your Google Account?","DefaultChoices":false,"DataExportTag":"C4","QuestionType":"MC","Selector":"SAVR","SubSelect