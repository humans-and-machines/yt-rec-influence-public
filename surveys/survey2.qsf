ices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We now ask that you delete your YouTube history. Please go to\u00a0https:\/\/www.youtube.com\/feed\/histor...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID137\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">We now ask that you delete your YouTube history.\n\n\nPlease go to&amp;nbsp;https:\/\/www.youtube.com\/feed\/history&amp;nbsp;and click on \"Clear all watch history,\" as indicated below. You will be asked to confi...<\/span> <span class=\"LeftOpDesc\">Yes<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID137\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID137","QuestionIDFromLocator":"QID137","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Incorrect response","libraryID":"UR_9Emt8LmPnWfvhGe","messageID":"MS_SEN26A6v2JdHtvl","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"We now ask that you delete your YouTube history.\n<br>\n<br>\nPlease go to&nbsp;<a href=\"https:\/\/www.youtube.com\/feed\/history\">https:\/\/www.youtube.com\/feed\/history<\/a>&nbsp;and click on \"Clear all watch history,\" as indicated below. You will be asked to confirm your action.<br>\n<br>\n<img style=\"width: 100%\" src=\"https:\/\/princetonsurvey.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_dmwOwEGUHolj5gq\">\n<br>\n<br><br><br>Have you deleted your history as instructed?<br>","DataExportTag":"DELETE_TREATMENT","QuestionID":"QID137"}},{"SurveyID"