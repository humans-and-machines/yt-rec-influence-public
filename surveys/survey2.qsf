,"QuestionID":"QID76","QuestionText":"Vegans are overly concerned about gaining weight.","QuestionText_Unsafe":"Vegans are overly concerned about gaining weight.","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID77","SecondaryAttribute":"Vegans are psychologically unhealthy.","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","3","4","5","6","7"],"Choices":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"Somewhat agree"},"6":{"Display":"Agree"},"7":{"Display":"Strongly agree"}},"Configuration":{"LabelPosition":"BELOW","QuestionDescriptionOption":"UseText"},"DataExportTag":"ATVS6","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":8,"QuestionDescription":"Vegans are psychologically unhealthy.","QuestionID":"QID77","QuestionText":"Vegans are psychologically unhealthy.","QuestionText_Unsafe":"Vegans are psychologically unhealthy.","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID78","SecondaryAttribute":"Individuals who don\u2019t consume animal products are \u201cwimpier\u201d than individuals who do","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","3","4","5","6","7"],"Choices":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"Somewhat agree"},"6":{"Display":"Agree"},"7":{"Display":"Strongly agree"}},"Configuration":{"LabelPosition":"BELOW","QuestionDescriptionOption":"UseText"},"DataExportTag":"ATVS7","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":8,"QuestionDescription":"Individuals who don\u2019t consume animal products are \u201cwimpier\u201d than individuals who do","QuestionID":"QID78","QuestionText":"Individuals who don\u2019t consume animal products are \u201cwimpier\u201d than individuals who do","QuestionText_Unsafe":"Individuals who don\u2019t consume animal products are \u201cwimpier\u201d than individuals who do","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID79","SecondaryAttribute":"In what follows, you will be asked to watch 30 videos and, occasionally, to answer knowledge ques...","TertiaryAttribute":null,"Payload":{"QuestionText":"In what follows, you will be asked to watch 30 videos and, occasionally, to answer knowledge questions about the videos.<br \/>\n<br \/>\nWe want these videos to be logged into your YouTube history, so please:\n<ol>\n\t<li>Copy paste the link into a browser tab where you are logged in into YouTube!<\/li>\n\t<li>Watch every video from start to end!<\/li>\n<\/ol>","DefaultChoices":false,"DataExportTag":"Q79","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In what follows, you will be asked to watch 30 videos and, occasionally, to answer knowledge ques...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID79"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Vegan eating habits are harmful to the traditions of this country.","TertiaryAttribute":null,"Payload":{"QuestionText":"Vegan eating habits are harmful to the traditions of this country.","DataExportTag":"ATVS03","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"Vegan eating habits are harmful to the traditions of this country.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID8"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID80","SecondaryAttribute":"Let us do the first video together! Please ","TertiaryAttribute":null,"Payload":{"QuestionText":"Let us do the first video together! Please&nbsp;","DefaultChoices":false,"DataExportTag":"Q80","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Let us do the first video together! Please ","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID80"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID81","SecondaryAttribute":"Click the link below (it will open the playlist in a new tab) and watch all 21 short videos in it...","TertiaryAttribute":null,"Payload":{"QuestionText":"Click the link below (it will open the playlist in a new tab) and watch all 21 short videos in it.<br>\n<br>\nIt should take you around 30 minutes.<br>\n<br>\n<a target=\"_blank\" href=\"https:\/\/www.youtube.com\/watch?v=9fogzZ_6kR0&amp;list=PLsSkbLxwJ50nzl3W9xNi-b2ndHDSdODhH\" rel=\"noopener\">https:\/\/www.youtube.com\/watch?v=9fogzZ_6kR0&amp;list=PLsSkbLxwJ50nzl3W9xNi-b2ndHDSdODhH<\/a>","DefaultChoices":false,"DataExportTag":"CONTROL_WATCH2","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click the link below (it will open the playlist in a new tab) and watch all 21 short videos in it...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID81"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID82","SecondaryAttribute":"In the last part of this experiment, you were asked to export your data. If your data is ready yo...","TertiaryAttribute":null,"Payload":{"QuestionText":"In the last part of this experiment, you were asked to export your data. If your data is ready you should have received an email like the one below:<br>\n<br>\n<br>\n<img width=\"60\" style=\"width: 60%;\" src=\"https:\/\/princetonsurvey.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_1EULesnHed5SrBA\"><br>\n<br>\nAlternatively, you can go to&nbsp;<a href=\"https:\/\/takeout.google.com\/\">https:\/\/takeout.google.com\/ <\/a>and download your data from there, as instructed below:<br>\n<br>\n<img width=\"70\" style=\"width: 70%;\" src=\"https:\/\/princetonsurvey.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_6xvq1oFDa1Ma4ES\"><br>\n<br>\nPlease proceed only if you have received this email and downloaded your data.","DefaultChoices":false,"DataExportTag":"TEXT_02","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the last part of this experiment, you were asked to export your data. If your data is ready yo...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID82"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID83","SecondaryAttribute":"Please upload the downloaded .zip files below. Please upload your files by clicking to upload (ra...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please upload the downloaded .zip files below.<br><br><b>Please upload your files by clicking to upload (rather than dragging and dropping) to avoid processing issues. If you drag and drop, the automatic data validation process will not run, and you may be manually screened out for improper data uploads after the completion of this survey.&nbsp;<br><\/b><br>Data uploads are validated for quality control. If your YouTube history does not indicate that you regularly watch the platform in the time immediately before the study began, you may be screened out from the study.&nbsp;<br><hr>","DefaultChoices":false,"DataExportTag":"TEXT_03","QuestionID":"QID83","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please upload the downloaded .zip files below. Please upload your files by clicking to upload (ra...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID84","SecondaryAttribute":"Upload the first file.","TertiaryAttribute":null,"Payload":{"QuestionText":"Upload the first file.<br><br>","DefaultChoices":false,"DataExportTag":"FILE1","QuestionType":"FileUpload","Selector":"FileUpload","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0","AudioOnly":false,"VideoUpload":false},"QuestionDescription":"Upload the first file.","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"ScreenCaptureText":"Capture Screen","QuestionID":"QID84","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    var that = this;\n    that.disableNextButton();\n    \n    var capturedFile = null;\n    var validationPassed = false;\n\n    function handleWatchHistoryJSON(jsonText) {\n        var parsed;\n        try {\n            parsed = JSON.parse(jsonText);\n        } catch (e) {\n            \/\/ alert(\"Error: watch-history.json could not be parsed as JSON.\\n\" + e.message);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData('HistoryCheck', 'Parsing Issue');\n            validationPassed = true;\n            that.enableNextButton();\n            return;\n        }\n        if (!Array.isArray(parsed)) {\n            \/\/ alert(\"Error: watch-history.json has an unexpected format (expected an array).\");\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData('HistoryCheck', 'Array Issue');\n            validationPassed = true;\n            that.enableNextButton();\n            return;\n        }\n\n        var now = new Date();\n        var twoWeeksAgo = new Date(now.getTime() - (14 * 24 * 60 * 60 * 1000));\n\n        var watchedVideos = parsed.filter(function(entry) {\n            return entry.titleUrl && entry.titleUrl.includes(\"youtube.com\/watch\");\n        });\n\n        var recentVideos = watchedVideos.filter(function(entry) {\n            var entryTime = new Date(entry.time);\n            return entryTime >= twoWeeksAgo && entryTime <= now;\n        });\n\n        if (recentVideos.length < 10) {\n            \/\/ alert(\"Warning: We only found \" + recentVideos.length + \" video(s) watched in the past two \tweeks.\\n\\n You may still proceed by clicking Next again.\");\n\t\t\t\/\/ alert(\"Warning: Your YouTube takeout indicates limited watch history in the past two weeks. Please ensure you uploaded the the correct file. Participants with a watch history that does not match the frequency of watching YouTube indicated in the first survey will be screened out.\");\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData('HistoryCheck', 'Insufficient History');\n        } else {\n            \/\/ alert(\n               \/\/ \"Success! Watch history verified.\\n\\n\" +\n               \/\/ recentVideos.length + \" videos watched in the past two weeks.\\n\\n\" +\n               \/\/ \"Click Next to proceed.\"\n            \/\/ );\n        }\n        validationPassed = true;\n        that.enableNextButton();\n    }\n\n    function processFile(file) {\n        if (!file) {\n            \/\/ alert(\"Error: No file detected. Please upload your file before continuing.\");\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData('HistoryCheck', 'No File');\n\t\t\tvalidationPassed = true;\n\t\t\tthat.enableNextButton();\n            return;\n        }\n\n        var isZip  = file.name.toLowerCase().endsWith('.zip');\n        var isJson = file.name.toLowerCase().endsWith('.json');\n\n        if (isJson) {\n            if (file.name.toLowerCase() === 'watch-history.json') {\n                var reader = new FileReader();\n                reader.onload = function(e) { handleWatchHistoryJSON(e.target.result); };\n                reader.readAsText(file);\n            } else {\n                \/\/ alert(\"Error: Uploaded .json file is not named watch-history.json.\");\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('HistoryCheck', 'No JSON');\n                validationPassed = true;\n                that.enableNextButton();\n            }\n            return;\n        }\n\n        if (isZip) {\n            JSZip.loadAsync(file).then(function(zip) {\n                var fileNames = Object.keys(zip.files);\n                if (fileNames.length === 0) {\n                    \/\/ alert(\"Error: Zip file is empty.\");\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('HistoryCheck', 'Empty Zip');\n                    validationPassed = true;\n                    that.enableNextButton();\n                    return;\n                }\n\n                var watchHistoryEntry = null;\n                for (var i = 0; i < fileNames.length; i++) {\n                    var segments = fileNames[i].split('\/');\n                    var fileName = segments[segments.length - 1];\n                    if (fileName.toLowerCase() === 'watch-history.json') {\n                        watchHistoryEntry = zip.files[fileNames[i]];\n                        break;\n                    }\n                }\n\n                if (!watchHistoryEntry) {\n                    \/\/ alert(\"Error: watch-history.json not found inside the zip.\\n\\nFiles found:\\n\" + fileNames.join(\"\\n\"));\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('HistoryCheck', 'No Json in Zip');\n                    validationPassed = true;\n                    that.enableNextButton();\n                    return;\n                }\n\n                watchHistoryEntry.async('string').then(function(jsonText) {\n                    handleWatchHistoryJSON(jsonText);\n                }).catch(function(e) {\n                    \/\/ alert(\"Error reading watch-history.json: \" + e.message);\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('HistoryCheck', 'Reading Issue');\n                    validationPassed = true;\n                    that.enableNextButton();\n                });\n            }).catch(function(e) {\n                \/\/ alert(\"Error: Could not open zip file.\\n\" + e.message);\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('HistoryCheck', 'Opening Issue');\n                validationPassed = true;\n                that.enableNextButton();\n            });\n        } else {\n            \/\/ alert(\"Error: Please upload a .zip file or a watch-history.json file.\");\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData('HistoryCheck', 'No Upload');\n            validationPassed = true;\n            that.enableNextButton();\n        }\n    }\n\n    var firstFileInput = document.querySelectorAll('input[type=\"file\"]')[0];\n    if (firstFileInput) {\n        firstFileInput.addEventListener('change', function() {\n            if (this.files && this.files.length > 0) {\n                capturedFile = this.files[0];\n                validationPassed = false; \/\/ reset if user swaps file\n                that.disableNextButton();\n            }\n        });\n    }\n\n    jQuery('#NextButton').on('click', function(e) {\n        if (validationPassed) return; \/\/ let Qualtrics handle it naturally\n        e.stopImmediatePropagation();\n        processFile(capturedFile);\n    });\n});\nQualtrics.SurveyEngine.addOnReady(function() { });\nQualtrics.SurveyEngine.addOnUnload(function() { });"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID85","SecondaryAttribute":"Upload the second file (if it exists).","TertiaryAttribute":null,"Payload":{"QuestionText":"Upload the second file (if it exists).<br><br>","DefaultChoices":false,"DataExportTag":"FILE2","QuestionType":"FileUpload","Selector":"FileUpload","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Upload the second file (if it exists).","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"ScreenCaptureText":"Capture Screen","QuestionID":"QID85","QuestionJS":false}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID86","SecondaryAttribute":"Upload the third file (if it exists).","TertiaryAttribute":null,"Payload":{"QuestionText":"Upload the third file (if it exists).<br><br>","DefaultChoices":false,"DataExportTag":"FILE3","QuestionType":"FileUpload","Selector":"FileUpload","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Upload the third f