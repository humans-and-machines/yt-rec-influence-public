ree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID41"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID42","SecondaryAttribute":"People who order vegan food often just are being cheap.","TertiaryAttribute":null,"Payload":{"QuestionText":"People who order vegan food often just are being cheap.","DefaultChoices":false,"DataExportTag":"ATVS16","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"People who order vegan food often just are being cheap.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID42"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID43","SecondaryAttribute":"Are you currently living in the United States of America?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you currently living in the United States of America?","DefaultChoices":false,"DataExportTag":"C1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Are you currently living in the United States of America?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID43"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID44","SecondaryAttribute":"How often do you use the following ","TertiaryAttribute":null,"Payload":{"QuestionText":"How often do you use the following&nbsp;","DefaultChoices":false,"DataExportTag":"Q44","QuestionType":"MC","Selector":"SB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How often do you use the following ","Choices":{"1":{"Display":"Facebook"},"2":{"Display":"Instagram"},"3":{"Display":"TikTok"},"4":{"Display":"YouTube"},"5":{"Display":"Reddit"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID44"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID45","SecondaryAttribute":"How often have you used the following social media platforms in the last two weeks?","TertiaryAttribute":null,"Payload":{"QuestionText":"How often have you used the following social media platforms in the last two weeks?","DefaultChoices":false,"DataExportTag":"C2","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"How often have you used the following social media platforms in the last two weeks?","Choices":{"1":{"Display":"Facebook"},"2":{"Display":"Instagram"},"3":{"Display":"TikTok"},"4":{"Display":"YouTube"},"5":{"Display":"X (formerly Twitter)"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":6,"Answers":{"1":{"Display":"Not at all"},"2":{"Display":"Several days"},"3":{"Display":"More than half the days"},"4":{"Display":"Nearly Every Day"},"5":{"Display":"Every Day"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionID":"QID45"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID46","SecondaryAttribute":"Please read each of the following statements about vegans and veganism and indicate the extent to...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please read each of the following statements about vegans and veganism and indicate the extent to which you agree or disagree.","DefaultChoices":false,"DataExportTag":"ATVS_2","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","Autoscale":{"XScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please read each of the following statements about vegans and veganism and indicate the extent to...","Choices":{"1":{"Display":"It\u2019s not O.K. to tease someone for being vegan."},"2":{"Display":"Refusing to consume animal products is just a phase."},"3":{"Display":"This is an attention check. Please mark agree."},"4":{"Display":"Vegans are too idealistic."},"5":{"Display":"I would approve if my children turned out to be vegans."},"6":{"Display":"It is acceptable for individuals to refuse to consume animal products that they have been served."},"7":{"Display":"Vegans respect the rights of others who choose to consume animal products."},"8":{"Display":"There are some good reasons not to consume animal products."}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":8,"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"Somewhat agree"},"6":{"Display":"Agree"},"7":{"Display":"Strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID46"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"Please read each of the following statements about vegans and veganism and indicate the extent to...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please read each of the following statements about vegans and veganism and indicate the extent to which you agree or disagree.","DefaultChoices":false,"DataExportTag":"ATVS_3","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","Autoscale":{"XScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please read each of the following statements about vegans and veganism and indicate the extent to...","Choices":{"1":{"Display":"Vegans use their eating habits to attract attention to themselves."},"2":{"Display":"People who order vegan food often just are being cheap."},"3":{"Display":"Many vegans secretly consume animal products in private."},"4":{"Display":"I avoid interacting with vegans whenever possible."},"5":{"Display":"Vegans believe that they are better than others are."},"6":{"Display":"People who refuse to consume animal products are childish and immature."},"7":{"Display":"In this row, mark strongly disagree."},"8":{"Display":"Vegans often appear sickly and unhealthy."}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":8,"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Disagree"},"3":{"Disp