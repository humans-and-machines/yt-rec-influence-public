"https:\/\/www.youtube.com\/watch?v=9fogzZ_6kR0&amp;list=PLsSkbLxwJ50nzl3W9xNi-b2ndHDSdODhH\" rel=\"noopener\">https:\/\/www.youtube.com\/watch?v=9fogzZ_6kR0&amp;list=PLsSkbLxwJ50nzl3W9xNi-b2ndHDSdODhH<\/a>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click the link below (it will open the playlist in a new tab) and watch all 21 short videos in it...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Click the following link (it will open in a new tab), Click the link below (it will open the playlist in a new tab) and watch all 36 short videos in it.<br \/>\n<br \/>\nIt should take you around 30 minutes.<br \/>\n<br \/>\n<a href=\"https:\/\/www.youtube.com\/watch?v=GZVntiYzvL0&amp;list=PLTvRHlm3c5b7cFLvtMf-iA_yHGp6xpPZq\" target=\"_blank\">https:\/\/www.youtube.com\/watch?v=GZVntiYzvL0&amp;list=PLTvRHlm3c5b7cFLvtMf-iA_yHGp6xpPZq<\/a>","DataExportTag":"TREATMENT_WATCH2","QuestionID":"QID139"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"You can eat a balanced diet without meat.","TertiaryAttribute":null,"Payload":{"QuestionText":"You can eat a balanced diet without meat.","DataExportTag":"","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"You can eat a balanced diet without meat.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID14"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID140","SecondaryAttribute":"Thank you for taking this survey. Please continue watching YouTube while logged in to the same ac...","TertiaryAttribute":null,"Payload":{"QuestionText":"Thank you for taking this survey. Please continue watching YouTube while logged in to the same account used for your data takeout. The $10 bonus payment is conditional upon your using the same YouTube account throughout the study. We will contact you to participate in the third step in about 10-12 days!","DefaultChoices":false,"DataExportTag":"END_TEXT","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for taking this survey. Please continue watching YouTube while logged in to the same ac...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID140"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID141","SecondaryAttribute":"Please go to\u00a0https:\/\/www.youtube.com\/feed\/history and take a screenshot of your history page. Upl..","TertiaryAttribute":null,"Payload":{"QuestionText":"Please go to&nbsp;<a href=\"https:\/\/www.youtube.com\/feed\/history\">https:\/\/www.youtube.com\/feed\/history<\/a> and take a screenshot of your history page. Upload that screenshot below.","DefaultChoices":false,"DataExportTag":"SCREENSHOT_CONTROL","QuestionType":"FileUpload","Selector":"FileUpload","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0","AudioOnly":false,"VideoUpload":false},"QuestionDescription":"Please go to\u00a0https:\/\/www.youtube.com\/feed\/history and take a screenshot of your history page. Upl...","