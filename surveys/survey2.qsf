tionText":"Please watch the following video:&nbsp;<a href=\"https:\/\/www.youtube.com\/shorts\/P_fb-xkjBgw\">video link<\/a>.\n<br>\n<iframe title=\"YouTube video player\" style=\"width:100%; height:800px;\" src=\"https:\/\/www.youtube.com\/embed\/P_fb-xkjBgw\"><\/iframe>\n<br>","DefaultChoices":false,"DataExportTag":"Q69","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please watch the following video:\u00a0video link.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID69"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Please read each of the following statements about vegans and veganism and indicate the extent to...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please read each of the following statements about vegans and veganism and indicate the extent to which you agree or disagree.","DefaultChoices":false,"DataExportTag":"ATVS_1","QuestionID":"QID7","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","Autoscale":{"XScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please read each of the following statements about vegans and veganism and indicate the extent to...","Choices":{"1":{"Display":"Vegans preach too much about their beliefs and eating habits."},"2":{"Display":"Vegans should not try to hide their eating habits."},"3":{"Display":"Vegan eating habits are harmful to the traditions of this country."},"4":{"Display":"This is just an attention check. Please mark somewhat disagree."},"5":{"Display":"You can eat a balanced diet without animal products."},"6":{"Display":"Vegans are overly concerned about gaining weight."},"7":{"Display":"Vegans are psychologically unhealthy."},"8":{"Display":"Individuals who don\u2019t consume animal products are \u201cwimpier\u201d than individuals who do"}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":8,"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"Somewhat agree"},"6":{"Display":"Agree"},"7":{"Display":"Strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID70","SecondaryAttribute":"The participant and host looked at research papers.","TertiaryAttribute":null,"Payload":{"QuestionText":"The participant and host looked at research papers.","DefaultChoices":false,"DataExportTag":"Q70","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The participant and host looked at research papers.","Choices":{"1":{"Display":"True"},"2":{"Display":"False"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID70"}},{"SurveyID":"SV_3lRgVrJmcHT6Bh4","Element":"SQ","PrimaryAttribute":"QID71","SecondaryAttribute":"Vegans preach too much about their beliefs and eating habits.","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","3","4","5","6","7"],"Choices":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"Somewhat agree"},"6":{"Display":"Agree"},"7":{"Display":"Str