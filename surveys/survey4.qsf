gle Account?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"},"3":{"Display":"I'm not sure"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID48"}},{"SurveyID":"SV_6S9KiVaN5VF3hWK","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"Do you log in into YouTube to watch videos?","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you log in into YouTube to watch videos?","DefaultChoices":false,"DataExportTag":"C4","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Do you log in into YouTube to watch videos?","Choices":{"1":{"Display":"Never"},"2":{"Display":"Almost never"},"3":{"Display":"About half the time"},"4":{"Display":"Almost always"},"5":{"Display":"Always"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID49"}},{"SurveyID":"SV_6S9KiVaN5VF3hWK","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"Vegans are psychologically unhealthy.","TertiaryAttribute":null,"Payload":{"QuestionText":"Vegans are psychologically unhealthy.","DataExportTag":"ATVS02","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"Vegans are psychologically unhealthy.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Va