":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":6,"Answers":{"1":{"Display":"Not at all"},"2":{"Display":"Several days"},"3":{"Display":"More than half the days"},"4":{"Display":"Nearly Every Day"},"5":{"Display":"Every Day"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionID":"QID45"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID46","SecondaryAttribute":"Please read each of the following statements about vegans and veganism and indicate the extent to...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please read each of the following statements about vegans and veganism and indicate the extent to which you agree or disagree.","DefaultChoices":false,"DataExportTag":"ATVS_2","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","Autoscale":{"XScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please read each of the following statements about vegans and veganism and indicate the extent to...","Choices":{"1":{"Display":"It\u2019s not O.K. to tease someone for being vegan."},"2":{"Display":"Refusing to consume animal products is just a phase."},"3":{"Display":"This is an attention check. Please mark agree."},"4":{"Display":"Vegans are too idealistic."},"5":{"Display":"I would approve if my children turned out to be vegans."},"6":{"Display":"It is acceptable for individuals to refuse to consume animal products that they have been served."},"7":{"Display":"Vegans respect the rights of others who choose to consume animal products."},"8":{"Display":"There are some good reasons not to consume animal products."}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":8,"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"Somewhat agree"},"6":{"Display":"Agree"},"7":{"Display":"Strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID46"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"Please read each of the following statements about vegans and veganism and indicate the extent to...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please read each of the following statements about vegans and veganism and indicate the extent to which you agree or disagree.","DefaultChoices":false,"DataExportTag":"ATVS23","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","Autoscale":{"XScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please read each of the following statements about vegans and veganism and indicate the extent to...","Choices":{"1":{"Display":"Vegans use their eating habits to attract attention to themselves."},"2":{"Display":"People who order vegan food often just are being cheap."},"3":{"Display":"Many vegans secretly consume animal products in private."},"4":{"Display":"I avoid interacting with vegans whenever possible."},"5":{"Display":"Vegans believe that they are better than others are."},"6":{"Display":"People who refuse to consume animal products are childish and immature."},"7":{"Display":"In this row, mark strongly disagree."},"8":{"Display":"Vegans often appear sickly and unhealthy."}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":8,"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"Somewhat agree"},"6":{"Display":"Agree"},"7":{"Display":"Strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID47"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID48","SecondaryAttribute":"Do you have a Google Account?","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you have a Google Account?","DefaultChoices":false,"DataExportTag":"C3","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you have a Google Account?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"},"3":{"Display":"I'm not sure"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID48"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"Do you log in into YouTube to watch videos?","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you log in into YouTube to watch videos?","DefaultChoices":false,"DataExportTag":"C4","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Do you log in into YouTube to watch videos?","Choices":{"1":{"Display":"Never"},"2":{"Display":"Almost never"},"3":{"Display":"About half the time"},"4":{"Display":"Almost always"},"5":{"Display":"Always"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID49"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"Vegans are psychologically unhealthy.","TertiaryAttribute":null,"Payload":{"QuestionText":"Vegans are psychologically unhealthy.","DataExportTag":"ATVS02","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"Vegans are psychologically unhealthy.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID5"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID50","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"C","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID50"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID51","SecondaryAttribute":"Do you watch YouTube while logged in to your Google Account?","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you watch YouTube while logged in to your Google Account?","DefaultChoices":false,"DataExportTag":"C4","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you watch YouTube while logged in to your Google Account?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"},"3":{"Display":"I'm not sure"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID51"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID52","SecondaryAttribute":"Would you be willing to delete your YouTube history as part of a research experiment? This means...","TertiaryAttribute":null,"Payload":{"QuestionText":"Would you be willing to delete your YouTube history as part of a research experiment?<br><br>This means that previous videos you have watched would no longer be available on your YouTube history, and that you would lose the personalization that YouTube does for your individual profile.\n<br>","DefaultChoices":false,"DataExportTag":"C5","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":true}}},"QuestionDescription":"Would you be willing to delete your YouTube history as part of a research experiment? This means...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID52"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"\u201cWhich of the following best describes a vegan diet?\u201d Options: A. A diet that excludes red meat ","TertiaryAttribute":null,"Payload":{"QuestionText":"\u201cWhich of the following best describes a vegan diet?\u201d\n\nOptions:\n\nA. A diet that excludes red meat but includes poultry, fish, and dairy\nB. A diet that excludes all meat but includes eggs and dairy\nC. A diet that excludes all animal products, including meat, dairy, eggs, and honey\nD. A diet that includes only raw fruits and vegetables","DefaultChoices":false,"DataExportTag":"KNOWLEDGE","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u201cWhich of the following best describes a vegan diet?\u201d Options: A. A diet that excludes red meat b...","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID53"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID54","SecondaryAttribute":"Your YouTube history contains the videos you have watched and the searches you have made on the p...","TertiaryAttribute":null,"Payload":{"QuestionText":"Your YouTube history contains the videos you have watched and the searches you have made on the platform, see below.<br>\n<br>\n<br>\n<img style=\"width: 100%\" src=\"https:\/\/princetonsurvey.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_6QN6IDtejDtu6ns\" alt=\"Access Watch History on YouTube website\">","DefaultChoices":false,"DataExportTag":"TEXT_02","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Your YouTube history contains the videos you have watched and the searches you have made on the p...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID54"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID55","SecondaryAttribute":"\u00a0this study, we ask you to donate your YouTube history for research purposes. We ask you to follo..","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;this study, we ask you to donate your YouTube history for research purposes.<br>\n<br>\nWe ask you to follow the instructions below to make a request for Google to provide you with your data.<br>\n<br>\nIn a day, we will contact you with the next steps. Google should have sent you the data by then.<br>\n<br>\n1. Go to&nbsp;https:\/\/takeout.google.com\/settings\/takeout","DefaultChoices":false,"DataExportTag":"extract","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0this study, we ask you to donate your YouTube history for research purposes. We ask you to follo...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID55"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"Would you be willing to donate your YouTube history as part of a research experiment? This means...","TertiaryAttribute":null,"Payload":{"QuestionText":"Would you be willing to donate your YouTube history as part of a research experiment?\n<br><br>This means you would extract all videos you have watched in the past and send them for research purposes. The exact details of how your data will be used will be discussed later, but we want to know if you are open to this possibility.","DefaultChoices":false,"DataExportTag":"C6","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":true}}},"QuestionDescription":"Would you be willing to donate your YouTube history as part of a research experiment? This means...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID56"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID57","SecondaryAttribute":"This survey is the first step in a three-part study.\u00a0 Part #1 (this survey; ~10 minutes): You wil..","TertiaryAttribute":null,"Payload":{"QuestionText":"This survey is the first step in a three-part study.&nbsp;<br>\n<br>\n<strong>Part #1 <\/strong>(this survey; ~10 minutes):\n<ol>\n\t<li>You will answer a questionnaire.<\/li>\n\t<li>You will&nbsp;<\/li>\n<\/ol>\n<br>\n<strong>Part #2 <\/strong>(in two to three days; ~30 minutes):\n\n<ol>\n\t<li>You will donate&nbsp;your YouTube history for research.<\/li>\n\t<li>You will watch a couple of YouTube videos.<\/li>\n\t<li>You will answer a questionnaire.<\/li>\n\t<li>You will be asked to delete your YouTube history.<\/li>\n<\/ol>\n<br>\n<strong>Part #3&nbsp;<\/strong>(in a month; ~10 minutes)\n\n<ol>\n\t<li>You will again be asked to donate your YouTube history.<\/li>\n\t<li>You will answer a questionnaire.<\/li>\n<\/ol><div><br><\/div><div>Upon completing the experiment, we will reward you with an additional $40. Would you be willing to participate?&nbsp;<\/div><div><\/div>&nbsp;","DefaultChoices":false,"DataExportTag":"Q57","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This survey is the first step in a three-part study.\u00a0 Part #1 (this survey; ~10 minutes): You wil...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID57"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"This survey is the first step in a four-part study Part #1\u00a0(this survey; ~10 minutes): You will a..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>This survey is the first step in a four-part study<\/p>\n<br>\n<strong>Part #1&nbsp;<\/strong>(this survey; ~10 minutes):\n\n<ol>\n\t<li>You will answer a questionnaire.<\/li>\n\t<li>You will request your YouTube history to Google.<\/li>\n<\/ol>\n<br>\n<strong>Part #2&nbsp;<\/strong>(in one to two days; ~40 minutes):\n\n<ol>\n\t<li>You will donate your YouTube history for research.<\/li>\n\t<li>You will watch a couple of YouTube videos.<\/li>\n\t<li>You will answer a questionnaire.<\/li>\n\t<li>You will be asked to delete your YouTube history.<\/li>\n<\/ol>\n<br>\n<strong>Part #3&nbsp;<\/strong>(in two weeks; ~10 minutes)\n\n<ol>\n\t<li>You will again be asked to request your YouTube history to Google.<\/li>\n\t<li>You will answer a questionnaire<\/li>\n<\/ol>\n<br>\n<strong>Part #4&nbsp;<\/strong>(a day or two after Part #3; ~5 minutes)\n\n<ol>\n\t<li>You will donate your YouTube history for research.<\/li>\n<\/ol>\n&nbsp;\n\n<p>Upon completing the full study, we will reward you with an additional $10. Would you be willing to participate?<\/p>","DefaultChoices":false,"DataExportTag":"C7","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":true}}},"QuestionDescription":"This survey is the first step in a four-part study Part #1\u00a0(this survey; ~10 minutes): You will a...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID58"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID59","SecondaryAttribute":"We ask you to donate your YouTube history for research purposes. We ask you to follow the instruc...","TertiaryAttribute":null,"Payload":{"QuestionText":"We ask you to donate your YouTube history for research purposes.<br>\n<br>\nWe ask you to follow the instructions below to make a request for Google to provide you with your data.<br>\n<br>\nWe will contact you with the next steps in a day. By then, Google should have sent you the data.<br><br><b>Please make note of the Google account for which you request your YouTube history, and we request that you use that specific account to watch YouTube for the next two weeks.<\/b><br>\n<br>\n1. Go to Google Takeout (this will open in a new tab:&nbsp;<a target=\"_blank\" href=\"https:\/\/takeout.google.com\/settings\/takeout\" rel=\"noopener\">https:\/\/takeout.google.com\/settings\/takeout<\/a>).<br>\n2. Click on \u201cDeselect All.\u201d<br>\n3. Scroll all the way down until you reach an item called \u201cYouTube and YouTube Music\u201d. Select this item.<br>\n4. Click on \u201cMultiple formats,\u201d change the search \"history\" format to \u201cjson\", and then click \"Ok\".<br>5. Click on \"All YouTube data included,\" so that a pop-up will open. (Note: if this button does not appear, try refreshing the page or waiting a few minutes and trying again. If that still fails, you can skip step 6 directly below, request the full takeout and upload only the watch-history.json file in the next survey.)<br>6. Click on \"Deselect all\" and then select only \"history.\" <b>This is important!<br><\/b>7. Select \u201cNext steps.\u201d&nbsp;<br>8. Change \u201cFile size\u201d to 50 GB.<br>9. Click \u201cCreate export.\u201d<br>\n<br>\nThis video reproduces the instructions above:<br>\n<br>\n<iframe title=\"YouTube video player\" style=\"width:100%; height:800px;\" src=\"https:\/\/www.youtube.com\/embed\/0JP_uwa8FAE\"><\/iframe><br>\n<br>\nHave you requested your data for takeout?","DefaultChoices":false,"DataExportTag":"TEXT_04","QuestionID":"QID59","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"We ask you to donate your YouTube history for research purposes. We ask you to follow the instruc...","Choices":{"4":{"Display":"Yes"},"5":{"Display":"No"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"I avoid interacting with vegans whenever possible.","TertiaryAttribute":null,"Payload":{"QuestionText":"I avoid interacting with vegans whenever possible.","DataExportTag":"ATVS03","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"I avoid interacting with vegans whenever possible.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID6"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID60","SecondaryAttribute":"In this study, we ask you to donate your YouTube history for research purposes. We ask you to fol...","TertiaryAttribute":null,"Payload":{"QuestionText":"In this study, we ask you to donate your YouTube history for research purposes.<br>\n<br>\nWe ask you to follow the instructions below to make a request for Google to provide you with your data.<br>\n<br>\nWe will contact you with the next steps in a day. By then, Google should have sent you the data.<br>\n<br>\n1. Go to Google Takeout (https:\/\/takeout.google.com\/settings\/takeout).<br>\n2. Click on \u201cDeselect All.\u201d<br>\n3. Scroll all the way down until you reach an item called \u201cYouTube and YouTube Music\u201d. Select this item.<br>\n4. Click on \u201cMultiple formats,\u201d and change the search history format to \u201cjson.\u201d<br>\n5. Select \u201cNext steps.\u201d&nbsp;<br>\n6. Change \u201cFile size\u201d to 50 GB.<br>\n7. Click \u201cCreate export.\u201d<br>\n<br>\n\nThis video reproduces the instructions above on a mobile interface:\n\n<br><br>\n\n\n<iframe width=\"560\" height=\"315\" src=\"https:\/\/www.youtube.com\/embed\/AuI5Pjy5xqo\" title=\"YouTube video player\"><\/iframe>","DefaultChoices":false,"DataExportTag":"Extraction","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In this study, we ask you to donate your YouTube history for research purposes. We ask you to fol...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID60"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID61","SecondaryAttribute":"For routine transactions, I would rather interact with an artificially intelligent system than wi...","TertiaryAttribute":null,"Payload":{"QuestionText":"For routine transactions, I would rather interact with an artificially intelligent system than with a human.","DefaultChoices":false,"DataExportTag":"GAAIS 1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition