its are harmful to the traditions of this country."},"4":{"Display":"This is just an attention check. Please mark somewhat disagree."},"5":{"Display":"You can eat a balanced diet without animal products."},"6":{"Display":"Vegans are overly concerned about gaining weight."},"7":{"Display":"Vegans are psychologically unhealthy."},"8":{"Display":"Individuals who don\u2019t consume animal products are \u201cwimpier\u201d than individuals who do"}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":23,"NextAnswerId":24,"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"Somewhat agree"},"6":{"Display":"Agree"},"7":{"Display":"Strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID70","SecondaryAttribute":"I find Artificial Intelligence sinister.","TertiaryAttribute":null,"Payload":{"QuestionText":"I find Artificial Intelligence sinister.","DefaultChoices":false,"DataExportTag":"GAAIS 8","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"I find Artificial Intelligence sinister.","Choices":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Somewhat disagree"},"4":{"Display":"Neither agree nor disagree"},"5":{"Display":"Somewhat agree"},"6":{"Display":"Agree"},"7":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID70"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID71","Second