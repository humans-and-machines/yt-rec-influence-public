","DefaultChoices":false,"DataExportTag":"Q25","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID25"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"You can eat a balanced diet without meat.","TertiaryAttribute":null,"Payload":{"QuestionText":"You can eat a balanced diet without meat.","DataExportTag":"ATVS21","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"You can eat a balanced diet without meat.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID26"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"Vegans are overly concerned about gaining weight.","TertiaryAttribute":null,"Payload":{"QuestionText":"Vegans are overly concerned about gaining weight.","DataExportTag":"ATVS06","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"Vegans are overly concerned about gaining weight.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID27"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"Vegans are psychologically unhealthy.","TertiaryAttribute":null,"Payload":{"QuestionText":"Vegans are psychologically unhealthy.","DataExportTag":"ATVS07","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"Vegans are psychologically unhealthy.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID28"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID29","SecondaryAttribute":"It\u2019s not O.K. to tease someone for being vegan.","TertiaryAttribute":null,"Payload":{"QuestionText":"It\u2019s not O.K. to tease someone for being vegan.","DefaultChoices":false,"DataExportTag":"ATVS08","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}}},"QuestionDescription":"It\u2019s not O.K. to tease someone for being vegan.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID29"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"This is a screener survey (Part 1 of 4) for a multi-week study on social media and public opinion...","TertiaryAttribute":null,"Payload":{"QuestionText":"<ul>\n\t<li>This is a screener survey (Part 1 of 4) for a multi-week study on social media and public opinions.<\/li>\n\t<li>We will ask you:<ul>\n\t\t<li>About your opinions and social media use.<\/li>\n\t\t<li>To export your social media data.<\/li>\n\t<\/ul>\n\t<\/li>\n\t<li>This study will help researchers at Princeton University and Humboldt University of Berlin better understand social media's role in shaping people's attitudes.&nbsp;<\/li>\n\t<li>Please read the consent form below with attention. If you agree to participate, there will be two other steps in this study.<\/li>\n\t<li>You will receive an extra $10 for completing the whole study.<\/li>\n<\/ul>\n&nbsp;\n\n<p>Please read the consent form below carefully.<\/p>\n\n<hr><br>\n<strong>ADULT CONSENT FORM<br>\nPRINCETON UNIVERSITY<\/strong><br>\n<br>\n<strong>TITLE OF RESEARCH:&nbsp;<\/strong>Assessing the Influence of Algorithms on Public Perceptions<br>\n<strong>PRINCIPAL INVESTIGATOR:<\/strong>&nbsp;Manoel Horta Ribeiro<br>\n<strong>PRINCIPAL INVESTIGATOR\u2019S DEPARTMENT:<\/strong> Computer Science<br>\n<br>\n<strong>Key information about the study<\/strong>\n\n<ul>\n\t<li>Informed consent: Your informed consent is being sought for research. Participation in the research is voluntary.&nbsp;<\/li>\n\t<li>Purpose of the research: The purpose of the research is to understand the effects of algorithms on YouTube. Specifically, we want to know how they shape public opinion.<\/li>\n\t<li>Expected Duration: The expected duration of the subject's participation is 40 minutes. These will be spread over four surveys. You will complete the first part of this study, and then receive emails to complete the other parts. All payments will be made via Prolific. You will be paid an extra $10 by completing all surveys.<\/li>\n\t<li>Procedures: You will be asked to answer a survey about your YouTube usage, demographic characteristics, and opinions. Then you will be asked to delete your YouTube history, watch a couple of videos, and subsequently donate your data. You will be able to preview all the data you donate. Data donated will be used and shared for research purposes.<\/li>\n\t<li>Risks: There are no reasonably foreseeable risks or discomforts to the subject due to participation.<\/li>\n\t<li>The benefits to the subject or to others. This study's value to society lies in its potential to illuminate the long-term influence of recommender systems on public opinion. Our findings may guide policy-making and platform regulation.<\/li>\n<\/ul>\n<br>\n<strong>Compensation<\/strong><br>\nYou will be compensated 12 USD\/hour for completing this initial survey and&nbsp;an extra $10 by completing all surveys.<br>\n<br>\n<strong>Who to contact with questions<\/strong><br>\nPrincipal investigator: Manoel Horta Ribeiro (socialmediaopinionstudy@gmail.com )<br>\nIf you have questions regarding your rights as a research subject, or if problems arise that you do not feel you can discuss with the Investigator, please contact the Institutional Review Board at: Assistant Director, Research Integrity and Assurance \/ Phone: (609) 258-8543 \/ Email: irb@princeton.edu<br>\n<br>\n<strong>Summary<\/strong>:\n\n<ul>\n\t<li>I understand the information that was presented and that:<\/li>\n\t<li>My participation is voluntary.<\/li>\n\t<li>Refusal to participate will involve no penalty or loss of benefits to which I am otherwise entitled.<\/li>\n\t<li>I may discontinue participation at any time without penalty or loss of benefits.<\/li>\n\t<li>I do not waive any legal rights or release Princeton University or its agents from liability for negligence.<\/li>\n<\/ul>\n<br>\nBy continuing with this form, I hereby give my consent to be the subject of the research.","DefaultChoices":false,"DataExportTag":"TEXT_01","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is a screener survey (Part 1 of 4) for a multi-week study on social media and public opinion...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID30","SecondaryAttribute":"Vegans respect the rights of others who choose to consume animal products.","TertiaryAttribute":null,"Payload":{"QuestionText":"Vegans respect the rights of others who choose to consume animal products.","DefaultChoices":false,"DataExportTag":"ATVS14","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"Vegans respect the rights of others who choose to consume animal products.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID30"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"It is acceptable for individuals to refuse to consume animal products that they have been served.","TertiaryAttribute":null,"Payload":{"QuestionText":"It is acceptable for individuals to refuse to consume animal products that they have been served.","DefaultChoices":false,"DataExportTag":"ATVS13","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"It is acceptable for individuals to refuse to consume animal products that they have been served.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID31"}},{"SurveyID":"SV_6zAf1ei3Utewr9Y","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"There are some good reasons not to consume animal products.","TertiaryAttribute":null,"Payload":{"QuestionText":"There are some good reasons not to consume animal products.","DefaultChoices":false,"DataExportTag":"ATVS10","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"agreeDisagree","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"There are some good reasons not to consume animal products.","Choices":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display"